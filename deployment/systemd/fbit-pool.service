[Unit]
Description=FewBit pool: stratum server (miners, share checking with the rxhash helper, block submission)
After=fbit-pool-redis.service fbit-node.service
Requires=fbit-pool-redis.service
[Service]
Type=simple
User=fbitpool
WorkingDirectory=/opt/fbit-nodejs-pool
ExecStart=/usr/bin/node /opt/fbit-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
