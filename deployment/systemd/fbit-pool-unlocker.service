[Unit]
Description=FewBit pool: block unlocker (credits the miners after the coinbase maturity)
After=fbit-pool-redis.service fbit-node.service
Requires=fbit-pool-redis.service
[Service]
Type=simple
User=fbitpool
WorkingDirectory=/opt/fbit-nodejs-pool
ExecStart=/usr/bin/node /opt/fbit-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
