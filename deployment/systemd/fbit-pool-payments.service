[Unit]
Description=FewBit pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=fbit-pool-redis.service fbit-node.service
Requires=fbit-pool-redis.service
[Service]
Type=simple
User=fbitpool
WorkingDirectory=/opt/fbit-nodejs-pool
ExecStart=/usr/bin/node /opt/fbit-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
