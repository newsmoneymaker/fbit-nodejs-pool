[Unit]
Description=FewBit pool: public API (127.0.0.1:8124)
After=fbit-pool-redis.service fbit-node.service
Requires=fbit-pool-redis.service
[Service]
Type=simple
User=fbitpool
WorkingDirectory=/opt/fbit-nodejs-pool
ExecStart=/usr/bin/node /opt/fbit-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
